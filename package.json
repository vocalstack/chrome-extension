{
  "name": "vocalstack-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VocalStack for Chrome and Edge: transcribe what a page plays, record tabs and meetings, run broadcasts, train voices.",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip && wxt zip -b edge",
    "check": "wxt prepare && tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "postinstall": "wxt prepare",
    "package": "scripts/package.sh",
    "publish:webstore": "VS_WEBSTORE=1 scripts/package.sh && node scripts/publish-webstore.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.2.2",
    "chrome-webstore-upload": "^6.0.1",
    "typescript": "^5.6.0",
    "wxt": "^0.21.4"
  }
}
